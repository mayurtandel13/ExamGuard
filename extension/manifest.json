{
  "manifest_version": 3,
  "name": "Exam Integrity Extension",
  "version": "1.0.0",
  "description": "Institutional & Integrity companion extension for ExamGuard AI Monitoring System.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:8501/*",
    "http://127.0.0.1:8501/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exam Integrity Extension"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:8501/*",
        "http://127.0.0.1:8501/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js", "popup.html"],
      "matches": ["http://localhost/*", "http://127.0.0.1/*"]
    }
  ]
}
